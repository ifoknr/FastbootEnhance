<Project Sdk="Microsoft.NET.Sdk">

  <!-- A stand-in for adb.exe, used only by the screenshots workflow so the Backup page can be
       exercised on a CI machine with no phone attached. Never shipped. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>adb</AssemblyName>
    <RootNamespace>FastbootEnhance.FakeAdb</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
