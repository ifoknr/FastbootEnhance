<Project Sdk="Microsoft.NET.Sdk">

  <!-- A stand-in for fastboot.exe, used only by the screenshots workflow so the device and
       flash pages can be exercised on a CI machine with no phone attached. Never shipped. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>fastboot</AssemblyName>
    <RootNamespace>FastbootEnhance.FakeFastboot</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
