<Window x:Class="FastbootEnhance.FastbootActionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:props="clr-namespace:FastbootEnhance.Properties"
        mc:Ignorable="d"
        ResizeMode="NoResize" SizeToContent="Height" Width="420"
        Background="{StaticResource Surface}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True"
        Title="Fastboot_create_resize" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="24,20,24,22">
        <TextBlock Style="{StaticResource SectionLabel}" Text="{x:Static props:Resources.fastboot_partition_name}"/>
        <TextBox FlowDirection="LeftToRight" x:Name="name" Margin="0,0,0,16" FontFamily="{StaticResource Mono}"/>
        <TextBlock Style="{StaticResource SectionLabel}" Text="{x:Static props:Resources.fastboot_partition_size_b}"/>
        <TextBox FlowDirection="LeftToRight" x:Name="size" Margin="0,0,0,20" FontFamily="{StaticResource Mono}"/>
        <TextBlock x:Name="note" Style="{StaticResource Note}" TextWrapping="Wrap" Margin="0,-6,0,18" Visibility="Collapsed"/>
        <Button x:Name="ok" Style="{StaticResource AccentButton}" HorizontalAlignment="Right" MinWidth="120"
                IsDefault="True" Content="{x:Static props:Resources.ok}"/>
    </StackPanel>
</Window>
