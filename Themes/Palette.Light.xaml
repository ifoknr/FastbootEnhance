<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:props="clr-namespace:FastbootEnhance.Properties">

    <!-- The light palette: the same keys as Palette.Dark.xaml. The accent, amber and red are
         darker here so they keep their contrast on white. -->
    <SolidColorBrush x:Key="Bg" Color="#F3F5F8"/>
    <SolidColorBrush x:Key="Rail" Color="#E9EDF2"/>
    <SolidColorBrush x:Key="Well" Color="#F7F9FB"/>
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Raised" Color="#EEF1F5"/>
    <SolidColorBrush x:Key="Hover" Color="#E3E8EE"/>
    <SolidColorBrush x:Key="Line" Color="#D3DAE3"/>
    <SolidColorBrush x:Key="Text" Color="#141A22"/>
    <SolidColorBrush x:Key="Dim" Color="#566273"/>
    <SolidColorBrush x:Key="Faint" Color="#768293"/>
    <SolidColorBrush x:Key="Accent" Color="#0B8F80"/>
    <SolidColorBrush x:Key="AccentInk" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#E2F4F1"/>
    <SolidColorBrush x:Key="AccentLine" Color="#97D3CA"/>
    <SolidColorBrush x:Key="Warn" Color="#A86A12"/>
    <SolidColorBrush x:Key="WarnSoft" Color="#FFF5E3"/>
    <SolidColorBrush x:Key="WarnLine" Color="#EBCB8F"/>
    <SolidColorBrush x:Key="Danger" Color="#C9332E"/>
    <SolidColorBrush x:Key="DangerSoft" Color="#FDEDEC"/>
    <SolidColorBrush x:Key="DangerLine" Color="#F0B6B3"/>
    <SolidColorBrush x:Key="Ok" Color="#23904A"/>
    <SolidColorBrush x:Key="Thumb" Color="#BFC8D3"/>

    <!-- Scroll bar corners and other bits WPF draws in system colours. -->
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightBrushKey}" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightLightBrushKey}" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkBrushKey}" Color="#FFFFFF"/>
</ResourceDictionary>
