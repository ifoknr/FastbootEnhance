<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>FastbootEnhance</RootNamespace>
    <!-- Shipped as Fastboot Studio; code namespaces keep the original project's name. -->
    <AssemblyName>FastbootStudio</AssemblyName>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <Platforms>AnyCPU;x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <PropertyGroup>
    <Version>2.3.0</Version>
    <AssemblyTitle>Fastboot Studio</AssemblyTitle>
    <Product>Fastboot Studio</Product>
    <Authors>IFOKNR; LibXZR</Authors>
    <Company>IFOKNR</Company>
    <Copyright>Copyright © 2021 LibXZR, © 2026 IFOKNR. MIT License.</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
    <SatelliteResourceLanguages>en;ar;zh-CN;ja-JP;ko-KR</SatelliteResourceLanguages>
    <!-- AssemblyInfo.cs is gone; these properties replace it. -->
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <!-- One self-contained exe, so users need nothing installed beforehand. -->
  <PropertyGroup>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Reflection over the generated protobuf types does not survive trimming. -->
    <PublishTrimmed>false</PublishTrimmed>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="src\FastbootEnhance.Core\FastbootEnhance.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- WMI, to see USB devices Windows has no driver for (the USB check). -->
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="icon.ico" />
    <EmbeddedResource Include="LICENSE" LogicalName="LICENSE.txt" />
    <Resource Include="big_icon.png" />
    <!-- Roboto and Noto Kufi Arabic, embedded so the interface looks the same on every PC. -->
    <Resource Include="Fonts\*.ttf" />
  </ItemGroup>

  <!-- Android platform-tools 37.0.1, shipped alongside the app and never inside the
       single-file bundle: fastboot.exe and adb.exe are started as their own processes and
       need the two Adb USB libraries next to them. The NOTICE is required by their licence. -->
  <ItemGroup>
    <Content Include="adb.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="Fonts\*-OFL.txt">
      <Link>licenses\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="platform-tools-NOTICE.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="fastboot.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="AdbWinApi.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="AdbWinUsbApi.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

  <!-- The library projects live under src/ and tests/ and must not be compiled into the app. -->
  <ItemGroup>
    <Compile Remove="src\**\*.cs" />
    <Compile Remove="tests\**\*.cs" />
    <Compile Remove="tools\**\*.cs" />
    <EmbeddedResource Remove="src\**\*.resx" />
    <EmbeddedResource Remove="tests\**\*.resx" />
    <EmbeddedResource Remove="tools\**\*.resx" />
    <None Remove="src\**" />
    <None Remove="tests\**" />
    <None Remove="tools\**" />
  </ItemGroup>

</Project>
