<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration for Fastboot Studio.
     The release workflow uploads FastbootStudio.exe alone; GitHub wraps it in a zip.
     Only Fastboot Studio's own executable is signed: adb.exe, fastboot.exe and the
     AdbWin*.dll files are Google's platform-tools, shipped as Google built them. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="FastbootStudio.exe">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
